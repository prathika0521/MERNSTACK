<!DOCTYPE html>
<html>
<head>
    <title>Digital Visiting Card</title>

    <style>
        body {
            background: #121212;
            font-family: Arial;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .card {
            background: #1e1e1e;
            color: white;
            padding: 25px;
            border-radius: 15px;
            width: 300px;
            text-align: center;
            box-shadow: 0 0 15px rgba(0,0,0,0.5);
        }

        h2 {
            margin-bottom: 5px;
        }

        h4 {
            color: #aaa;
            margin-top: 0;
        }

        .info {
            text-align: left;
            margin-top: 15px;
        }

        .info p {
            margin: 8px 0;
        }

        .skills {
            margin-top: 15px;
        }

        .skill {
            display: inline-block;
            background: #333;
            padding: 5px 10px;
            margin: 5px;
            border-radius: 8px;
            font-size: 12px;
        }

        a {
            color: #4da6ff;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="card">
        <h2>Prathika</h2>
        <h4>Web Developer</h4>

        <div class="info">
            <p>📞 +91 7289597820</p>
            <p>📧 prathikagatty5@gmail.com</p>
            <p>📍 Mangalore</p>
            <p>🔗 <a href="#">LinkedIn Profile</a></p>
        </div>

        <div class="skills">
            <span class="skill">HTML</span>
            <span class="skill">CSS</span>
            <span class="skill">JavaScript</span>
            <span class="skill">React</span>
        </div>
    </div>

</body>
</html>
